# ───────── Shohoz Kitchen Server — environment template ─────────
# Copy this to `.env` and fill in the real values. `.env` is gitignored.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (REQUIRED).
# Point this at a NEW, empty database for this project — the root seed/delete
# scripts run against it and will happily wipe whatever they find.
DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/shohozkitchen

# JWT — generate STRONG secrets for production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Cloudinary (product/image upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email / SMTP — optional. If left blank, emails (verification, invoice) are
# logged to the console in dev instead of being sent. Add a Gmail app password
# to go live.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@shohozkitchen.com

FRONTEND_URL=http://localhost:3000

# bKash (sandbox until real merchant creds are added)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_SANDBOX=true

# SSLCommerz (sandbox until real store creds are added)
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_SANDBOX=true

# Base URLs for payment gateway callbacks/redirects
PAYMENT_BACKEND_URL=http://localhost:5000
PAYMENT_FRONTEND_URL=http://localhost:3000

# Steadfast courier API (Phase: fulfillment) — keep ONLY in .env, never in code.
# NOTE: rotate the old key that was shared in the requirement screenshots.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_SECRET=

# xAI Grok — powers the ShohozBot website AI assistant (SERVER-SIDE ONLY).
# Get a key + add credits at https://console.x.ai
GROK_API_KEY=
GROK_MODEL=grok-3
GROK_BASE_URL=https://api.x.ai/v1

# Admin / demo seed scripts (src/scripts/setup-admin.ts, check-admin.ts, src/seed.ts).
# Passwords live here only — never in source, the repository is public.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=
SEED_PASSWORD=
SUPERADMIN_EMAIL=superadmin@gmail.com
SUPERADMIN_PASSWORD=
