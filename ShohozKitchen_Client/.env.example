# ───────── Shohoz Kitchen Client — environment template ─────────
# Copy to `.env.local` and fill in. Everything here is NEXT_PUBLIC_*, i.e. shipped
# to the browser — never put a secret in this file.

# Express API base URL (ShohozKitchen_Server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public site URL (canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
